diff --git a/migrations/0007_total_cents.py b/migrations/0007_total_cents.py
new file mode 100644
--- /dev/null
+++ b/migrations/0007_total_cents.py
@@ -0,0 +1,14 @@
+def upgrade(db):
+    db.execute("ALTER TABLE orders ADD COLUMN total_cents INTEGER")
+    db.execute("UPDATE orders SET total_cents = CAST(ROUND(total * 100) AS INTEGER)")
+    db.execute("ALTER TABLE orders DROP COLUMN total")
+
+
+def downgrade(db):
+    raise NotImplementedError("the float totals are not kept")
